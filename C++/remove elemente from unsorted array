class Solution {
  public:
    vector<int> removeDuplicate(vector<int>& arr) {
        // code here
        map<int, int>mp;
        vector<int> result;
        
        for(int i=0;i<arr.size();i++){
            mp[arr[i]]++;
            if(mp[arr[i]]==1){
                result.push_back(arr[i]);
            }
        }
        return result;
    }
};
