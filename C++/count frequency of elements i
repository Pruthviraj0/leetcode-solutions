class Solution {
  public:
    vector<int> frequencyCount(vector<int>& arr) {
        // code here
       int n=arr.size();
       
       vector<int> freq(n, 0);
       
       for(int i=0;i<n;i++){
           
           int key =arr[i];
           
           freq[key-1]++;
       }
       return freq;
    }
};
