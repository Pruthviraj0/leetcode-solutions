class Solution {
  public:
    vector<int> removeDuplicates(vector<int> &arr) {
        // code here
        int j=0;
        
        for(int i =0;i<arr.size();i++){
            if(arr[i]!=arr[j]){
                j++;
                arr[j]=arr[i];
            }
        }
        arr.resize(j+1);
        return arr;
    }
};
