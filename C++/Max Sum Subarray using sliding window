//sliding window technique- we use when we have  perform operations on subarray 
//sub arrays are continous means 10,20,30 then 10,30 is not subarray.
//Max Sub Array 
//first check for arr[i] is greater or equal to k,then sub i form k,add next arr[i] into sum(5), we'll get our max sub array.
#include <iostream>
#include <vector>
using namespace std;

int maxSumSubarray(vector<int> &arr, int k){

int n=arr.size();
int ans;
int sum=0;
    for(int i=0;i<k;i++){
        sum=sum+arr[i];
    }

    ans= sum;
    for(int i=k;i<n;i++){
        sum=sum+arr[i];
        sum=sum-arr[i-k];
        ans=max(sum,ans);
    }

    return ans;
}
int main(){
    vector<int> arr={1,2,3,4,5,6,7,8,9};
    int k=2;
    cout<<maxSumSubarray(arr,k);
    return 0;
}
