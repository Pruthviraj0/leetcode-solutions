class Solution {
  public:
    int firstNonRepeating(vector<int>& arr) {
        // code here
        map<int, int>mp;
        for(int i=0;i<arr.size();i++){
            int key=arr[i];
            mp[key]++;
        }
        for(int i=0;i<arr.size();i++){
            if(mp[arr[i]]==1){
                return arr[i];
            }
        }
        return 0;
    }
};
