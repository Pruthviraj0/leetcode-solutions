class Solution {
  public:
    string equilibrium(vector<int> &arr) {
        // code here
    int n = arr.size();
    vector<int> prefix( n+1, 0);
     
    for(int i = 0 ; i <= n ; i++ ){
         
        prefix[i]=prefix[i-1]+arr[i-1];
     }
     
     int sum=0;
     
     for(int i=n-1;i>=0;i--){
         
        if(prefix[i]==sum) return "true";
        sum+=arr[i];
     }
     return "false";
    }
};
