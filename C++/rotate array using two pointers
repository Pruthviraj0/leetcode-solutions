//this is a method in which we dont have to use the hashmap but it costs more time complexity, here we use simple two pointer technique.
//using hashmap is more efficient

#include <iostream>
#include <vector>
using namespace std;

void isSubset(vector<int>&arr, int b) {
	int n=arr.size();

	b=b%n;

	int i=0;
	int j=b-1;
	while(i<j) {
		swap(arr[i],arr[j]);
		i++;
		j--;
	}

	i=b;
	j=n-1;
	while(i<j) {
		swap(arr[i],arr[j]);
		i++;
		j--;
	}
	i=0;
	j=n-1;
	while(i<j) {
		swap(arr[i], arr[j]);
		i++;
		j--;
	}
}

int main() {
	vector<int>arr= {1,2,3,12,34,21};
	int b=3;

	isSubset(arr, b);
	for( int x : arr) {
		cout<<x<< " ";
	}
	return 0;
}
