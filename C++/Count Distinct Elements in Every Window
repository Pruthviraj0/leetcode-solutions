//sliding window technique- we use when we have  perform operations on subarray 
//Count Distinct Elements in Every Window
#include <iostream>
#include <vector>
#include <map>
using namespace std;

vector<int> countDistinct(vector<int> &arr, int k){

int n=arr.size();
vector<int> ans;

    map<int, int> mp;
    
    for(int i=0;i<n;i++){
        mp[arr[i]]++;
        if(i>=k){
            mp[arr[i-k]]--;
            if(mp[arr[i-k]]==0){
                mp.erase(arr[i-k]);
            }
        }
        if(i >= k-1){
            ans.push_back(mp.size());
        }
    }
    return ans;
}
int main(){
    vector<int> arr={1,2,3,4,5,6,7,8,9};
    int k=2;
    vector<int> result=countDistinct(arr,k);
    for(int x : result){
        cout<<x<<" ";
    }
    return 0;
}
