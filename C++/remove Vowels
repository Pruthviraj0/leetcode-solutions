#include <iostream>
#include <vector>
#include <map>
#include <string>
using namespace std;
//string
//remove vowels
//just look for vowels in the string and add to another string.
//we are removing so ans string should not contain any vowels.

string removeVowels(string& str){
   int n=str.size();
   string ans;
   
   for(int i=0;i<n;i++){
       char ch=str[i];
       
       if(ch !='a'&& ch != 'e' && ch !='i'&& ch !='o'&& ch !='u'){
           
           ans.push_back(ch);
       }
   }
   return ans;
   
}

   

int main(){
    string str={"abcdefghijk"};
    
    cout<<removeVowels(str);
    
    return 0;
}
