class Solution {
  public:
    string removeChars(string &s) {
        // code here
        int n =s.size();
        
        string ans;
        
        for(int i=0;i<n;i++){
            char ch=s[i];
            if(isalpha(ch)){
                ans.push_back(ch);
            }
        }

        return ans;
    }
};
