#include <iostream>
#include <vector>
using namespace std;
//string
//palindrom string
//when read from both side it gives same meaning

int isPalindrom(string& str){
    int i=0;
    int j=str.size()-1;
    
    while(i<j){
        if(str[i]!=str[j]){
            return false;
        }
        else{
            i++;
            j--;
        }
    }
    return true;
}

   

int main(){
    string str={"abc"};
    cout<<isPalindrom(str);
    
    return 0;
}
