#include <iostream>
#include <string>
#include <map>
using namespace std;

char leastfrequecny(string &s){

    map<char, int> mp;

    for(int i=0;i<s.length();i++){
        mp[s[i]]++;
    }

    for(int i=0; i<s.length();i++){
        if(mp[s[i]]==1){
            return s[i];
        }
    }
    return '$';
    
}
int main(){
    string s={"racecar"};
    cout<<leastfrequecny(s);

    return 0;
}
