#include <iostream>
#include <vector>
using namespace std;

//Kadane's Algorithm -medium 
int maxSubarraySum(vector<int>&arr){
    int ans=0;
    int sum=0;
    
    for(int i = 0; i < arr.size() ; i++){
        
        sum=max(sum+arr[i], arr[i]);
        
        ans=max( sum , ans);
    }
    return ans;
}
int main(){
    vector<int> arr={-1,-4,-5,3,7,2,4};
    cout<<maxSubarraySum(arr);
    return 0;
}
