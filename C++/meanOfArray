class Solution {
  public:
    int findMean(vector<int>& arr) {
        // code here
        int sum=0;
        int count=0;
        
        for(int i = 0; i < arr.size(); i++){
            sum=sum+arr[i];
            count++;
        }
        
        int mean=sum/count;
        return mean;
    }
};
